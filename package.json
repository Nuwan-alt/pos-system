{
  "name": "pos-system",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mysql2": "^3.11.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/globalSetup.js",
    "globalTeardown": "<rootDir>/test/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/test/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "testTimeout": 20000
  }
}
